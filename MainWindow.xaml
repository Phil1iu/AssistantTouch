<Window x:Class="AssistantTouch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssistantTouch"
        mc:Ignorable="d"
        Title="AssistantTouch"
        Width="72" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Cursor="SizeAll">

    <!-- 浅色菜单主题：白底、1px #1F000000 边、6px 圆角、内边距 4、悬停 #F2F2F2、
         分隔线 #E5E5E5、文字深灰 #1A1A1A。只改外观，不改菜单项与行为。 -->
    <Window.Resources>
        <Style x:Key="BallContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#1F000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BallMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemRoot"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           FontSize="11"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9A9A9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BallMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E5E5E5" Margin="6,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Grid 必须有不透明/透明但不为 null 的背景，否则空白区域不参与命中测试，拖拽会失效 -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          TouchDown="OnTouchDown"
          TouchMove="OnTouchMove"
          TouchUp="OnTouchUp">

        <!-- 右键菜单：重置位置 / 关于 / 分隔线 / 退出。
             右键由 ContextMenuService 自动弹出；左键单击（无拖动）也会在 250ms 后打开同一个菜单。
             拖拽改为手动实现（4px 阈值），因此不再使用 DragMove()。 -->
        <Grid.ContextMenu>
            <ContextMenu Opened="OnBallMenuOpened" Style="{StaticResource BallContextMenuStyle}">
                <MenuItem Header="重置位置" Click="OnResetPositionClick" Style="{StaticResource BallMenuItemStyle}" />
                <MenuItem Header="开机自启" IsCheckable="True" Click="OnAutostartClick" Style="{StaticResource BallMenuItemStyle}" />
                <Separator Style="{StaticResource BallMenuSeparatorStyle}" />
                <MenuItem Header="关于" Click="OnAboutClick" Style="{StaticResource BallMenuItemStyle}" />
                <MenuItem Header="退出" Click="OnExitClick" Style="{StaticResource BallMenuItemStyle}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Margin=2 保持不变：球体直径维持 68px（72px 窗口内留 2px 边），本轮不改布局/尺寸。
             Issue #1 风格 B：纯白极简 + 1px 细灰渐变环，删除投影效果与 2px 深色描边。 -->
        <Ellipse Margin="2">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <!-- 常态：近纯白填充（96% 白，保留轻微半透明观感）+ 1px 对角灰渐变环（深→浅）。
                         环的深端用于白底可见性，浅端制造「细灰渐变」而不是生硬黑边。 -->
                    <Setter Property="Fill" Value="#F5FFFFFF" />
                    <Setter Property="StrokeThickness" Value="1" />
                    <Setter Property="Stroke">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.146,0.146" EndPoint="0.854,0.854">
                                <GradientStop Color="#80000000" Offset="0" />
                                <GradientStop Color="#1F000000" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- 悬停：填充到纯白，环整体加深一档；缩放改为 1.04，避免弹跳感。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="#FFFFFFFF" />
                            <Setter Property="Stroke">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.146,0.146" EndPoint="0.854,0.854">
                                        <GradientStop Color="#A6000000" Offset="0" />
                                        <GradientStop Color="#40000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
    </Grid>
</Window>
