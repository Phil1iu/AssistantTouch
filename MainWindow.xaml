<Window x:Class="AssistantTouch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssistantTouch"
        mc:Ignorable="d"
        Title="AssistantTouch"
        Width="72" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Cursor="SizeAll">

    <!-- Grid 必须有不透明/透明但不为 null 的背景，否则空白区域不参与命中测试，拖拽会失效 -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftButtonUp">

        <!-- 右键菜单：重置位置 / 关于 / 分隔线 / 退出。
             右键由 ContextMenuService 自动弹出；左键单击（无拖动）也会在 250ms 后打开同一个菜单。
             拖拽改为手动实现（4px 阈值），因此不再使用 DragMove()。 -->
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="重置位置" Click="OnResetPositionClick" />
                <MenuItem Header="关于" Click="OnAboutClick" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Margin=2 保持不变：球体直径维持 68px（72px 窗口内留 2px 边），本轮不改布局/尺寸。
             Issue #1 风格 B：纯白极简 + 1px 细灰渐变环，删除投影效果与 2px 深色描边。 -->
        <Ellipse Margin="2">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <!-- 常态：近纯白填充（96% 白，保留轻微半透明观感）+ 1px 对角灰渐变环（深→浅）。
                         环的深端用于白底可见性，浅端制造「细灰渐变」而不是生硬黑边。 -->
                    <Setter Property="Fill" Value="#F5FFFFFF" />
                    <Setter Property="StrokeThickness" Value="1" />
                    <Setter Property="Stroke">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.146,0.146" EndPoint="0.854,0.854">
                                <GradientStop Color="#80000000" Offset="0" />
                                <GradientStop Color="#1F000000" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- 悬停：填充到纯白，环整体加深一档；缩放改为 1.04，避免弹跳感。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Fill" Value="#FFFFFFFF" />
                            <Setter Property="Stroke">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0.146,0.146" EndPoint="0.854,0.854">
                                        <GradientStop Color="#A6000000" Offset="0" />
                                        <GradientStop Color="#40000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
        </Ellipse>
    </Grid>
</Window>
