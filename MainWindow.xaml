<Window x:Class="AssistantTouch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AssistantTouch"
        mc:Ignorable="d"
        Title="AssistantTouch"
        Width="72" Height="72"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Cursor="SizeAll">

    <!-- 浅色菜单主题：白底、1px #1F000000 边、6px 圆角、内边距 4、悬停 #F2F2F2、
         分隔线 #E5E5E5、文字深灰 #1A1A1A。只改外观，不改菜单项与行为。 -->
    <Window.Resources>
        <Style x:Key="BallContextMenuStyle" TargetType="ContextMenu">
            <Setter Property="Background" Value="#FFFFFFFF" />
            <Setter Property="BorderBrush" Value="#1F000000" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BallMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemRoot"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           FontSize="11"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="#F2F2F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#9A9A9A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BallMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#E5E5E5" Margin="6,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Grid 必须有不透明/透明但不为 null 的背景，否则空白区域不参与命中测试，拖拽会失效 -->
    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="OnMouseLeftButtonDown"
          MouseMove="OnMouseMove"
          MouseLeftButtonUp="OnMouseLeftButtonUp"
          TouchDown="OnTouchDown"
          TouchMove="OnTouchMove"
          TouchUp="OnTouchUp"
          LostTouchCapture="OnLostTouchCapture">

        <!-- 右键菜单：重置位置 / 开机自启 / 关于 / 退出。右键由 ContextMenuService 自动弹出；
             左键只用于拖拽（未拖动时不执行任何动作）。拖拽为手动实现（4px 阈值），不再使用 DragMove()。 -->
        <Grid.ContextMenu>
            <ContextMenu Opened="OnBallMenuOpened" Style="{StaticResource BallContextMenuStyle}">
                <MenuItem Header="重置位置" Click="OnResetPositionClick" Style="{StaticResource BallMenuItemStyle}" />
                <MenuItem Header="开机自启" IsCheckable="True" Click="OnAutostartClick" Style="{StaticResource BallMenuItemStyle}" />
                <Separator Style="{StaticResource BallMenuSeparatorStyle}" />
                <MenuItem Header="关于" Click="OnAboutClick" Style="{StaticResource BallMenuItemStyle}" />
                <MenuItem Header="退出" Click="OnExitClick" Style="{StaticResource BallMenuItemStyle}" />
            </ContextMenu>
        </Grid.ContextMenu>

        <!-- Margin=2 保持不变：球体直径维持 68px（72px 窗口内留 2px 边），本轮只改外观、不改布局/尺寸。
             磨砂玻璃观感（纯 WPF，不用 DWM/SetWindowCompositionAttribute）：
             半透明白底 + 细噪点雾面 + 左上柔和高光 + 内圈 1px 半透明反光 + 外圈 1px 淡灰轮廓。
             噪点画刷由代码生成（FrostedGlassBrush），此处用 DynamicResource 引用；静态画刷，无每帧计算。 -->
        <ContentControl x:Name="BallSurface" Margin="2" Focusable="False" IsTabStop="False">
            <ContentControl.Template>
                <ControlTemplate TargetType="ContentControl">
                    <Grid x:Name="GlassRoot" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <!-- 玻璃底：72% 白，能隐约透出背后的桌面内容。 -->
                        <Ellipse x:Name="GlassBase"
                                 Fill="#B8FFFFFF"
                                 Stroke="#59000000"
                                 StrokeThickness="1" />

                        <!-- 雾面：程序生成的灰度细噪点，透明度 8%（悬停 10%）。 -->
                        <Ellipse x:Name="GlassNoise"
                                 Fill="{DynamicResource GlassNoiseBrush}"
                                 Opacity="0.08"
                                 IsHitTestVisible="False" />

                        <!-- 高光：左上方柔和径向渐变，营造玻璃厚度。 -->
                        <Ellipse x:Name="GlassGloss" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush GradientOrigin="0.28,0.24"
                                                     Center="0.32,0.28"
                                                     RadiusX="0.78"
                                                     RadiusY="0.78">
                                    <GradientStop Color="#40FFFFFF" Offset="0" />
                                    <GradientStop Color="#00FFFFFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- 内圈 1px 半透明白：玻璃边缘反光，与外圈深色描边形成双层玻璃边。 -->
                        <Ellipse x:Name="GlassInnerRing"
                                 Stroke="#80FFFFFF"
                                 StrokeThickness="1"
                                 Margin="1"
                                 IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：整体略提高不透明度、边缘反光更亮；保留 1.04 缩放，不加动画。 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="GlassBase" Property="Fill" Value="#D9FFFFFF" />
                            <Setter TargetName="GlassNoise" Property="Opacity" Value="0.10" />
                            <Setter TargetName="GlassInnerRing" Property="Stroke" Value="#A6FFFFFF" />
                            <Setter TargetName="GlassRoot" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ContentControl.Template>
        </ContentControl>
    </Grid>
</Window>
