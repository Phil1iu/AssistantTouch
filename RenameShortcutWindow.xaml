<Window x:Class="AssistantTouch.RenameShortcutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名快捷方式"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="True">

    <!-- 白底细边圆角小对话框；Esc 取消，Enter 确定。 -->
    <Border Background="#FFFFFFFF"
            BorderBrush="#1F000000"
            BorderThickness="1"
            CornerRadius="6"
            Padding="16">
        <StackPanel>
            <TextBlock Text="快捷方式名称（最多 20 个字符）"
                       Foreground="#1A1A1A"
                       FontSize="12"
                       Margin="0,0,0,8" />

            <TextBox x:Name="NameBox"
                     MaxLength="20"
                     FontSize="13"
                     Padding="6,4"
                     BorderBrush="#1F000000"
                     BorderThickness="1" />

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="确定"
                        IsDefault="True"
                        Width="80"
                        Height="28"
                        Margin="0,0,8,0"
                        Background="#0078D4"
                        Foreground="#FFFFFFFF"
                        BorderBrush="#0069BD"
                        Click="OnOkClick" />
                <Button Content="取消"
                        IsCancel="True"
                        Width="80"
                        Height="28"
                        Background="#F5F5F5"
                        Foreground="#1A1A1A"
                        BorderBrush="#1F000000" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
