<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AssistantTouch</AssemblyName>
    <RootNamespace>AssistantTouch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <!-- WPF 入口的 DPI 感知由 app.manifest 声明 PerMonitorV2；WFAC010 是 WinForms
         分析器建议改用 ApplicationHighDpiMode 的提示，不适用于本 WPF 应用（WinForms 仅用于托盘）。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- 测试/工具工程在 tests/、tools/ 下；主工程的默认 glob 必须排除，
         否则会被 WPF 临时工程当源码编译（tools/TouchProbe 是独立控制台项目）。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会把 System.Drawing / System.Windows.Forms 加进隐式 using，
         与 WPF 的 Point/Application/MouseEventArgs 等撞名；托盘代码里显式 using 即可。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- 托盘直接从程序集资源里复用同一个 ico（ApplicationIcon 只影响 exe 图标）。 -->
    <Resource Include="assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 仅测试程序集可见（纯函数 TryParse / WindowClamp）。 -->
    <InternalsVisibleTo Include="AssistantTouch.Tests" />
  </ItemGroup>

</Project>
