<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AssistantTouch</AssemblyName>
    <RootNamespace>AssistantTouch</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会把 System.Drawing / System.Windows.Forms 加进隐式 using，
         与 WPF 的 Point/Application/MouseEventArgs 等撞名；托盘代码里显式 using 即可。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
