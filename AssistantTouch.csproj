<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AssistantTouch</AssemblyName>
    <RootNamespace>AssistantTouch</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WPF 入口的 DPI 感知由 app.manifest 声明 PerMonitorV2；WFAC010 是 WinForms
         分析器建议改用 ApplicationHighDpiMode 的提示，不适用于本 WPF 应用（WinForms 仅用于托盘）。 -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseWindowsForms 会把 System.Drawing / System.Windows.Forms 加进隐式 using，
         与 WPF 的 Point/Application/MouseEventArgs 等撞名；托盘代码里显式 using 即可。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
